DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=frogis

# Random string, at least 32 characters: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Public address of this copy of the site (canonical URLs, Open Graph, sitemap). Default: https://www.frog-is.com
SITE_URL=

# 1 = tell search engines not to index this copy (demo / staging). Read at build time: rebuild after changing.
SITE_NOINDEX=
